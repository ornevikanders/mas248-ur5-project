<?xml version="1.0"?>
<robot name="mas248_ur5e" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Main arguments -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="safety_limits" default="true"/>
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="use_fake_hardware" default="true"/>

  <!-- Vendor robot model (keep original package untouched) -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/> <!-- Here we define the original UR5e model from a driver -->


<!-- Workcell: world -> pedestal_link -> UR5e ... tool0 -> spindle_body -> tcp -->

  <!-- ===== Measured lab geometry: change values HERE only ===== -->
  <!-- world = the table surface under the pedestal. The pedestal stands ON the table and the
       paper lies on the same table, so the drawing plane is z = 0 and the robot base is
       pedestal_height above it (photo of the lab cell 2026-11-09).
       Pedestal: height measured in the lab (0.31 m, table to robot base). It is a round
       aluminium column on a square foot plate with a round top plate; those sizes are
       NOT measured (placeholders read from the photo). -->
  <xacro:property name="pedestal_height"      value="0.31"/>
  <xacro:property name="pedestal_radius"      value="0.08"/>
  <xacro:property name="pedestal_foot_size"   value="0.30"/>
  <xacro:property name="pedestal_foot_height" value="0.015"/>
  <xacro:property name="pedestal_top_radius"  value="0.10"/>
  <xacro:property name="pedestal_top_height"  value="0.015"/>

  <!-- Paper centre in world: (+0.50, +0.06) m (moved from x = 0.43 in the lab 2026-11-09).
       First measured from the axis marks on the robot base as (-0.43, -0.06); the marks follow
       UR's 'base' frame (teach pendant), which is rotated pi
       about z relative to ROS base_link/world, so x and y change sign.
       VERIFIED in the lab 2026-11-09: the paper lies at positive x and y in world. -->
  <xacro:property name="paper_x" value="0.50"/>
  <xacro:property name="paper_y" value="0.06"/>

  <!-- Table: one table under both the pedestal and the paper; its top is world z = 0.
       Size and position NOT measured (placeholder: reaches behind the pedestal and well
       past the paper). -->
  <xacro:property name="table_top_z"     value="0.0"/>
  <xacro:property name="table_thickness" value="0.05"/>
  <xacro:property name="table_length_x"  value="1.40"/>
  <xacro:property name="table_width_y"   value="1.20"/>
  <xacro:property name="table_center_x"  value="0.30"/>
  <xacro:property name="table_center_y"  value="0.0"/>

  <!-- Keep-out zone: nothing on the robot may go below the table top, also outside the
       modelled table. Extra collision box on table_link, no visual, from keepout_depth below
       the table top up to keepout_margin below it. -->
  <xacro:property name="keepout_size"   value="2.0"/>
  <xacro:property name="keepout_depth"  value="0.30"/>
  <xacro:property name="keepout_margin" value="0.01"/>

  <!-- Paper: A4 lying on the table, centred on (paper_x, paper_y). Long side along world y
       (across in front of the robot): x spans 0.325..0.535 m, so the near edge stays clear
       of the pedestal foot and the reach varies less than with the long side along x.
       Place the real sheet the same way. Visual only (no collision), so the pen can touch it;
       1 mm thick so it shows on top of the table in RViz. -->
  <xacro:property name="paper_size_x"    value="0.210"/>
  <xacro:property name="paper_size_y"    value="0.297"/>
  <xacro:property name="paper_thickness" value="0.001"/>

  <!-- Workcell root -->
  <link name="world"/>  <!-- I am dummy -->
  <link name="tcp"/> <!-- I am also dummy -->

  <!-- Pedestal: square foot plate on the table, round column, round top plate = robot base -->
  <link name="pedestal_link">
    <visual>
      <origin xyz="0 0 ${pedestal_foot_height/2}" rpy="0 0 0"/>
      <geometry><box size="${pedestal_foot_size} ${pedestal_foot_size} ${pedestal_foot_height}"/></geometry>
      <material name="pedestal_foot"><color rgba="0.45 0.45 0.47 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 ${pedestal_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${pedestal_radius}" length="${pedestal_height}"/></geometry>
      <material name="pedestal"><color rgba="0.78 0.79 0.81 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 ${pedestal_height - pedestal_top_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${pedestal_top_radius}" length="${pedestal_top_height}"/></geometry>
      <material name="pedestal"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${pedestal_foot_height/2}" rpy="0 0 0"/>
      <geometry><box size="${pedestal_foot_size} ${pedestal_foot_size} ${pedestal_foot_height}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${pedestal_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${pedestal_top_radius}" length="${pedestal_height}"/></geometry>
    </collision>
  </link>

  <!-- Pen tool and TCP, expressed in tool0 (the UR tool flange: z out of the flange).
       Checked on the real robot 2026-11-09: in the pose where the real pen points straight down,
       ROS reported tool0 at (-0.516, -0.056, -0.107) m in base (model: -0.517, -0.057, -0.107)
       and tool0 +y pointing straight down. So the pen runs along tool0 +y, at right angles to
       the flange. TCP measured in the lab: 0.10 m along the pen, 0.065 m out from the flange.
       The TCP frame has z along the pen (towards the tip) and x along -tool0 z, so with
       image_to_targets (tcp z down, tcp x = world x) the flange faces the robot as in the lab.
       Tool sizes are NOT measured (placeholders read from the photo):
         adapter ring on the flange, gripper plate, black pen holder box, green pen, light tip. -->
  <xacro:property name="tcp_along_pen" value="0.10"/>
  <xacro:property name="tcp_z"         value="0.065"/>
  <xacro:property name="ring_radius"     value="0.032"/>
  <xacro:property name="ring_length"     value="0.020"/>
  <xacro:property name="plate_size_pen"  value="0.075"/>  <!-- along the pen (tool0 y) -->
  <xacro:property name="plate_size_side" value="0.060"/>  <!-- across (tool0 x) -->
  <xacro:property name="plate_thickness" value="0.020"/>
  <xacro:property name="holder_size_pen"  value="0.060"/>
  <xacro:property name="holder_size_side" value="0.055"/>
  <xacro:property name="holder_size_z"    value="0.050"/>
  <xacro:property name="holder_center"    value="0.005"/>  <!-- holder centre along the pen -->
  <xacro:property name="pen_radius"      value="0.0075"/>
  <xacro:property name="tip_radius"      value="0.003"/>
  <xacro:property name="tip_length"      value="0.012"/>
  <xacro:property name="pen_clearance"   value="0.008"/>
  <!-- derived -->
  <xacro:property name="plate_z0"   value="${ring_length}"/>
  <xacro:property name="holder_z0"  value="${ring_length + plate_thickness}"/>
  <xacro:property name="holder_end" value="${holder_center + holder_size_pen / 2}"/>
  <xacro:property name="pen_length" value="${tcp_along_pen - tip_length - holder_end}"/>
  <!-- a cylinder lies along +y after rolling it -90 deg about x -->
  <xacro:property name="along_pen" value="${-pi / 2} 0 0"/>

  <link name="spindle_body">
    <!-- adapter ring on the flange -->
    <visual>
      <origin xyz="0 0 ${ring_length / 2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${ring_radius}" length="${ring_length}"/></geometry>
      <material name="tool_ring"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <!-- gripper plate -->
    <visual>
      <origin xyz="0 0 ${plate_z0 + plate_thickness / 2}" rpy="0 0 0"/>
      <geometry><box size="${plate_size_side} ${plate_size_pen} ${plate_thickness}"/></geometry>
      <material name="tool_plate"><color rgba="0.22 0.20 0.18 1.0"/></material>
    </visual>
    <!-- black pen holder; the pen axis runs through it at z = tcp_z -->
    <visual>
      <origin xyz="0 ${holder_center} ${holder_z0 + holder_size_z / 2}" rpy="0 0 0"/>
      <geometry><box size="${holder_size_side} ${holder_size_pen} ${holder_size_z}"/></geometry>
      <material name="tool_holder"><color rgba="0.06 0.06 0.06 1.0"/></material>
    </visual>
    <!-- green pen body from the holder along +y -->
    <visual>
      <origin xyz="0 ${holder_end + pen_length / 2} ${tcp_z}" rpy="${along_pen}"/>
      <geometry><cylinder radius="${pen_radius}" length="${pen_length}"/></geometry>
      <material name="pen"><color rgba="0.05 0.45 0.25 1.0"/></material>
    </visual>
    <!-- light pen tip ending exactly at the TCP -->
    <visual>
      <origin xyz="0 ${tcp_along_pen - tip_length / 2} ${tcp_z}" rpy="${along_pen}"/>
      <geometry><cylinder radius="${tip_radius}" length="${tip_length}"/></geometry>
      <material name="pen_tip"><color rgba="0.92 0.92 0.90 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${ring_length / 2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${ring_radius}" length="${ring_length}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${plate_z0 + plate_thickness / 2}" rpy="0 0 0"/>
      <geometry><box size="${plate_size_side} ${plate_size_pen} ${plate_thickness}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 ${holder_center} ${holder_z0 + holder_size_z / 2}" rpy="0 0 0"/>
      <geometry><box size="${holder_size_side} ${holder_size_pen} ${holder_size_z}"/></geometry>
    </collision>
    <!-- pen collision stops pen_clearance before the tip, so pen-down poses are not collisions -->
    <collision>
      <origin xyz="0 ${(holder_end + tcp_along_pen - pen_clearance) / 2} ${tcp_z}" rpy="${along_pen}"/>
      <geometry><cylinder radius="${pen_radius}" length="${tcp_along_pen - pen_clearance - holder_end}"/></geometry>
    </collision>
  </link>

  <joint name="tool0_to_spindle" type="fixed">
    <parent link="tool0"/>
    <child link="spindle_body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- TCP at the pen tip. rpy (-pi/2, pi/2, 0): tcp z = tool0 +y (along the pen),
       tcp x = -tool0 z, tcp y = -tool0 x. -->
  <joint name="spindle_to_tcp" type="fixed">
    <parent link="spindle_body"/>
    <child link="tcp"/>
    <origin xyz="0 ${tcp_along_pen} ${tcp_z}" rpy="${-pi / 2} ${pi / 2} 0"/>
  </joint>
<!-- we do not need a joint between a pedestal and robot: ur_robot parent="pedestal_link" creates it -->

  <joint name="world_to_pedestal" type="fixed">
    <parent link="world"/>
    <child link="pedestal_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Instantiate UR robot -->
  <xacro:ur_robot
    name="$(arg name)"
    ur_type="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    parent="pedestal_link"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="0.15"
    safety_k_position="20"
    generate_ros2_control_tag="false"
    use_fake_hardware="$(arg use_fake_hardware)"
    headless_mode="true"
    robot_ip="$(arg robot_ip)"
    script_filename=""
    input_recipe_filename=""
    output_recipe_filename=""
  >
    <!-- Mount the robot on top of the pedestal -->
    <origin xyz="0 0 ${pedestal_height}" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Work table under the pedestal and the paper; top surface = drawing plane (z = table_top_z) -->
  <link name="table_link">
    <visual>
      <origin xyz="${table_center_x} ${table_center_y} ${table_top_z - table_thickness/2}" rpy="0 0 0"/>
      <geometry><box size="${table_length_x} ${table_width_y} ${table_thickness}"/></geometry>
      <material name="table"><color rgba="0.62 0.60 0.56 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="${table_center_x} ${table_center_y} ${table_top_z - table_thickness/2}" rpy="0 0 0"/>
      <geometry><box size="${table_length_x} ${table_width_y} ${table_thickness}"/></geometry>
    </collision>
    <!-- keep-out zone below the table top (collision only, see keepout_size) -->
    <collision>
      <origin xyz="0 0 ${table_top_z - (keepout_depth + keepout_margin) / 2}" rpy="0 0 0"/>
      <geometry><box size="${keepout_size} ${keepout_size} ${keepout_depth - keepout_margin}"/></geometry>
    </collision>
  </link>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Paper sheet on the table (visual only) -->
  <link name="paper_link">
    <visual>
      <origin xyz="0 0 ${paper_thickness/2}" rpy="0 0 0"/>
      <geometry><box size="${paper_size_x} ${paper_size_y} ${paper_thickness}"/></geometry>
      <material name="paper"><color rgba="0.97 0.97 0.95 1.0"/></material>
    </visual>
  </link>
  <joint name="table_to_paper" type="fixed">
    <parent link="table_link"/>
    <child link="paper_link"/>
    <origin xyz="${paper_x} ${paper_y} ${table_top_z}" rpy="0 0 0"/>
  </joint>

</robot>
