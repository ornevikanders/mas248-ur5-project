<?xml version="1.0"?>
<robot name="mas248_ur5e" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Main arguments -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="safety_limits" default="true"/>
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="use_fake_hardware" default="true"/>

  <!-- Vendor robot model (keep original package untouched) -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/> <!-- Here we define the original UR5e model from a driver -->


<!-- Workcell: world -> pedestal_link -> UR5e ... tool0 -> spindle_body -> tcp -->

  <!-- ===== Measured lab geometry: change values HERE only ===== -->
  <!-- Pedestal: height measured in the lab (0.31 m). Width NOT measured yet (placeholder). -->
  <xacro:property name="pedestal_height" value="0.31"/>
  <xacro:property name="pedestal_width"  value="0.20"/>

  <!-- Paper centre in world: (+0.43, +0.06) m. Measured from the axis marks on the robot base
       as (-0.43, -0.06); the marks follow UR's 'base' frame (teach pendant), which is rotated pi
       about z relative to ROS base_link/world, so x and y change sign.
       VERIFIED in the lab 2026-11-09: the paper lies at positive x and y in world. -->
  <xacro:property name="paper_x" value="0.43"/>
  <xacro:property name="paper_y" value="0.06"/>

  <!-- Table: top is flush with the top of the pedestal (measured).
       Length/width NOT measured yet: placeholder centred under the paper.
       Keep paper_x - table_length_x/2 >= pedestal_width/2 so the table does not overlap the pedestal. -->
  <xacro:property name="table_top_z"     value="${pedestal_height}"/>
  <xacro:property name="table_thickness" value="0.05"/>
  <xacro:property name="table_length_x"  value="0.60"/>
  <xacro:property name="table_width_y"   value="0.60"/>

  <!-- Keep-out zone: nothing on the robot may go below the table top, anywhere around the
       robot (gap between pedestal and table, beside the table, the floor). Extra collision
       box on table_link, no visual. Its top is keepout_margin below the table top so the
       robot base (which sits at table_top_z) does not touch it. It overlaps the pedestal,
       which is fine: the SRDF disables pedestal_link/table_link collisions ("Never"). -->
  <xacro:property name="keepout_size"   value="2.0"/>
  <xacro:property name="keepout_margin" value="0.01"/>

  <!-- Paper: A4 lying on the table, centred on (paper_x, paper_y). Long side along world y
       (across in front of the robot): x spans 0.325..0.535 m, so the near edge stays 22 cm
       from the pedestal and the reach varies less than with the long side along x.
       Place the real sheet the same way. Visual only (no collision), so the pen can touch it;
       1 mm thick so it shows on top of the table in RViz. -->
  <xacro:property name="paper_size_x"    value="0.210"/>
  <xacro:property name="paper_size_y"    value="0.297"/>
  <xacro:property name="paper_thickness" value="0.001"/>

  <!-- Workcell root -->
  <link name="world"/>  <!-- I am dummy -->
  <link name="tcp"/> <!-- I am also dummy -->

  <!-- Pedestal: built directly into this workcell, top face = robot base -->
  <link name="pedestal_link">
    <visual>
      <origin xyz="0 0 ${pedestal_height/2}" rpy="0 0 0"/>
      <geometry><box size="${pedestal_width} ${pedestal_width} ${pedestal_height}"/></geometry>
      <material name="pedestal"><color rgba="0.30 0.30 0.32 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${pedestal_height/2}" rpy="0 0 0"/>
      <geometry><box size="${pedestal_width} ${pedestal_width} ${pedestal_height}"/></geometry>
    </collision>
  </link>

  <!-- Pen tool and TCP, expressed in tool0 (the UR tool flange, same frame as the pendant TCP).
       TCP measured in the lab 2026-11-09: x = 0.10 m, z = 0.065 m, no rotation (tcp z = tool0 z). -->
  <xacro:property name="tcp_x" value="0.10"/>
  <xacro:property name="tcp_z" value="0.065"/>
  <!-- Tool shape NOT measured (placeholders): a box on the flange reaching out past the TCP,
       and a pen hanging down from the end of the box with a thin tip exactly at the TCP.
       Box: x from -box_back to tcp_x + box_front, z from 0 to box_height (flange side up).
       The pen collision stops pen_clearance above the TCP so pen-down poses on the table
       are not reported as collisions; the thin tip is visual only. -->
  <xacro:property name="box_back"      value="0.03"/>
  <xacro:property name="box_front"     value="0.03"/>
  <xacro:property name="box_width"     value="0.05"/>
  <xacro:property name="box_height"    value="0.03"/>
  <xacro:property name="pen_radius"    value="0.006"/>
  <xacro:property name="tip_radius"    value="0.002"/>
  <xacro:property name="tip_length"    value="0.008"/>
  <xacro:property name="pen_clearance" value="0.008"/>
  <xacro:property name="box_length"    value="${box_back + tcp_x + box_front}"/>
  <xacro:property name="box_center_x"  value="${(tcp_x + box_front - box_back) / 2}"/>
  <xacro:property name="pen_length"    value="${tcp_z - box_height - tip_length}"/>

  <link name="spindle_body">
    <!-- tool box -->
    <visual>
      <origin xyz="${box_center_x} 0 ${box_height / 2}" rpy="0 0 0"/>
      <geometry><box size="${box_length} ${box_width} ${box_height}"/></geometry>
      <material name="spindle"><color rgba="0.85 0.45 0.10 1.0"/></material>
    </visual>
    <!-- pen body from the underside of the box -->
    <visual>
      <origin xyz="${tcp_x} 0 ${box_height + pen_length / 2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${pen_radius}" length="${pen_length}"/></geometry>
      <material name="pen"><color rgba="0.10 0.20 0.70 1.0"/></material>
    </visual>
    <!-- pen tip ending exactly at the TCP -->
    <visual>
      <origin xyz="${tcp_x} 0 ${tcp_z - tip_length / 2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${tip_radius}" length="${tip_length}"/></geometry>
      <material name="pen_tip"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="${box_center_x} 0 ${box_height / 2}" rpy="0 0 0"/>
      <geometry><box size="${box_length} ${box_width} ${box_height}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${tcp_x} 0 ${(box_height + tcp_z - pen_clearance) / 2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${pen_radius}" length="${tcp_z - pen_clearance - box_height}"/></geometry>
    </collision>
  </link>

  <joint name="tool0_to_spindle" type="fixed">
    <parent link="tool0"/>
    <child link="spindle_body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="spindle_to_tcp" type="fixed">
    <parent link="spindle_body"/>
    <child link="tcp"/>
    <origin xyz="${tcp_x} 0 ${tcp_z}" rpy="0 0 0"/>
  </joint>
<!-- we do not need a joint between a pedestal and robot: ur_robot parent="pedestal_link" creates it -->

  <joint name="world_to_pedestal" type="fixed">
    <parent link="world"/>
    <child link="pedestal_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Instantiate UR robot -->
  <xacro:ur_robot
    name="$(arg name)"
    ur_type="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    parent="pedestal_link"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="0.15"
    safety_k_position="20"
    generate_ros2_control_tag="false"
    use_fake_hardware="$(arg use_fake_hardware)"
    headless_mode="true"
    robot_ip="$(arg robot_ip)"
    script_filename=""
    input_recipe_filename=""
    output_recipe_filename=""
  >
    <!-- Mount the robot on top of the pedestal -->
    <origin xyz="0 0 ${pedestal_height}" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Work table carrying the paper; top surface = drawing plane (z = table_top_z) -->
  <link name="table_link">
    <visual>
      <origin xyz="${paper_x} ${paper_y} ${table_top_z - table_thickness/2}" rpy="0 0 0"/>
      <geometry><box size="${table_length_x} ${table_width_y} ${table_thickness}"/></geometry>
      <material name="table"><color rgba="0.75 0.75 0.78 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="${paper_x} ${paper_y} ${table_top_z - table_thickness/2}" rpy="0 0 0"/>
      <geometry><box size="${table_length_x} ${table_width_y} ${table_thickness}"/></geometry>
    </collision>
    <!-- keep-out zone below the table top (collision only, see keepout_size) -->
    <collision>
      <origin xyz="0 0 ${(table_top_z - keepout_margin) / 2}" rpy="0 0 0"/>
      <geometry><box size="${keepout_size} ${keepout_size} ${table_top_z - keepout_margin}"/></geometry>
    </collision>
  </link>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Paper sheet on the table (visual only) -->
  <link name="paper_link">
    <visual>
      <origin xyz="0 0 ${paper_thickness/2}" rpy="0 0 0"/>
      <geometry><box size="${paper_size_x} ${paper_size_y} ${paper_thickness}"/></geometry>
      <material name="paper"><color rgba="0.97 0.97 0.95 1.0"/></material>
    </visual>
  </link>
  <joint name="table_to_paper" type="fixed">
    <parent link="table_link"/>
    <child link="paper_link"/>
    <origin xyz="${paper_x} ${paper_y} ${table_top_z}" rpy="0 0 0"/>
  </joint>

</robot>
